[Unit]
Description=Daily "what's new on MaccabiPedia" note, every morning

[Timer]
OnCalendar=*-*-* 09:00:00
# A morning the PC was off runs as soon as it is back; the note's window starts where the
# last sent one ended, so nothing is lost or repeated.
Persistent=true
RandomizedDelaySec=5m

[Install]
WantedBy=timers.target
